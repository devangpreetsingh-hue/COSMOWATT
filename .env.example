# Copy to .env, then restart `npm run dev`. Every VITE_ value is visible in the browser, so never put passwords here.
VITE_BACKEND_URL=
# Map look: osm | satellite | maptiler
VITE_MAP_STYLE=osm
VITE_MAPTILER_KEY=
# Only for Open-Meteo's paid commercial plan
VITE_OPEN_METEO_API_KEY=
VITE_DEFAULT_NAME=Bhopal
VITE_DEFAULT_LAT=23.26
VITE_DEFAULT_LON=77.41
